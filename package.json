{
  "name": "noble-job",
  "version": "1.0.0",
  "description": "Noble Job — India's trusted job portal. An Initiative of NCC Foundation.",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "node scripts/clean-next.mjs && next dev -p 3000",
    "dev:reset": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev-ports.ps1 && node scripts/clean-next.mjs && next dev -p 3000",
    "prebuild:local": "node scripts/prebuild.mjs",
    "build": "next build",
    "build:local": "node scripts/prebuild.mjs && next build",
    "build:hostinger": "next build && node scripts/prepare-hostinger-standalone.mjs",
    "pack:hostinger": "npm run build:hostinger && node scripts/package-hostinger-standalone.mjs",
    "start": "next start",
    "start:hostinger": "node .next/standalone/server.js",
    "start:standalone": "node server.js",
    "prepare:standalone": "node scripts/prepare-hostinger-standalone.mjs",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed.js",
    "db:seed:govt": "tsx scripts/seed-govt-jobs.ts",
    "db:generate-types": "supabase gen types typescript --local > src/types/supabase.ts",
    "verify:rbac": "node scripts/verify-rbac.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:signup": "node scripts/verify-signup-e2e.mjs",
    "db:apply": "node scripts/apply-supabase-migrations.mjs",
    "db:apply:migration": "node scripts/apply-migration.mjs",
    "verify:users": "node scripts/verify-users-table.mjs",
    "verify:storage": "node scripts/verify-storage-resumes.mjs",
    "verify:schema": "node scripts/verify-schema-drift.mjs",
    "verify:resend": "node scripts/verify-resend.mjs",
    "verify:oauth": "node scripts/verify-oauth.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:job-schema": "tsx scripts/verify-job-schema.ts",
    "test:provenance": "tsx src/lib/jobs/provenance.test.ts",
    "test:acq": "tsx src/lib/resume/scoreBand.test.ts",
    "test:egress": "tsx src/lib/config/govtCache.test.ts",
    "audit:provenance": "tsx scripts/audit-jobs-provenance.ts",
    "deploy:storage": "node scripts/apply-migration.mjs 006_storage_resumes.sql && node scripts/apply-migration.mjs 008_storage_rls_helpers.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "chart.js": "4.4.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.447.0",
    "next": "15.5.19",
    "next-themes": "^0.3.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.0",
    "resend": "^4.0.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.10",
    "postgres": "^3.4.9",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "ws": "^8.21.0"
  }
}
