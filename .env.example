# ── SUPABASE ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Database password (Dashboard → Settings → Database) — required for npm run db:apply
SUPABASE_DB_PASSWORD=your-database-password-here

# ── APP ───────────────────────────────────────────────────────
# Production (Hostinger): must match your live domain exactly (no trailing slash)
NEXT_PUBLIC_APP_URL=https://www.noblejob.in
NEXT_PUBLIC_APP_NAME="Noble Job"
NODE_ENV=production

# Hostinger sets PORT automatically; optional overrides:
# PORT=3000
# HOSTNAME=0.0.0.0

# Job listings: `local` (seeded inventories), `supabase`, or omit (auto)
NEXT_PUBLIC_JOB_DATA_SOURCE=local

# ── EMAIL (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM="Noble Job <noreply@noblejob.in>"
EMAIL_SUPPORT=support@noblejob.in
EMAIL_FEEDBACK=feedback@noblejob.in
EMAIL_INFO=info@noblejob.in

# ── OTP ───────────────────────────────────────────────────────
# Supabase handles OTP — no extra key needed.
# Twilio (optional backup):
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_VERIFY_SERVICE_ID=your-verify-service-id

# ── EXTERNAL APIs ─────────────────────────────────────────────
HIMALAYAS_API_BASE=https://himalayas.app/jobs/api
# Himalayas is free — no key required.

# ── ADMIN ─────────────────────────────────────────────────────
# Admin email is set in Supabase Auth + users table (role=admin).
# Never hardcode passwords. Set via Supabase dashboard.
ADMIN_EMAIL=admin@noblejob.in
# Recipient for admin alert emails (new candidate/employer/job/resume).
# Falls back to ADMIN_EMAIL → EMAIL_SUPPORT when unset.
ADMIN_NOTIFICATION_EMAIL=admin@noblejob.in

# ── OAUTH ─────────────────────────────────────────────────────
# Configure in Supabase Auth → Providers → Google / LinkedIn.
# No extra env vars needed for OAuth flows (handled by Supabase).
# Supabase → Authentication → URL Configuration:
#   Site URL: https://www.noblejob.in
#   Redirect URLs: https://www.noblejob.in/auth/callback
# Google Cloud Console → OAuth client → Authorized redirect URIs:
#   https://<project-ref>.supabase.co/auth/v1/callback

# ── CRON (production) ─────────────────────────────────────────
# Required for /api/cron/govt-jobs in production (do not leave unset)
CRON_SECRET=generate-a-long-random-string-here

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── CACHE ─────────────────────────────────────────────────────
HIMALAYAS_CACHE_TTL_SECONDS=3600
JOBS_ISR_REVALIDATE_SECONDS=300

# ── STORAGE ───────────────────────────────────────────────────
# resumes bucket must stay PRIVATE (see migrations/006_storage_resumes.sql)
SUPABASE_STORAGE_BUCKET_RESUMES=resumes
SUPABASE_STORAGE_BUCKET_LOGOS=company-logos
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# ── AI RESUME SCORE (optional) ────────────────────────────────
# The AI Resume Score works WITHOUT these keys using deterministic ATS/keyword
# analysis. Set ONE provider to upgrade the "Recommendations" to AI-generated.
# Provider is inferred from whichever key is present; AI_PROVIDER overrides.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
